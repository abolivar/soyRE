NODE_ENV=development

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PROXY_URL=
API_PORT=4000

# Public marketing surface. Keep indexing disabled until DNS and legal gates pass.
NEXT_PUBLIC_SITE_URL=https://soypms-alpha.vercel.app
NEXT_PUBLIC_DEMO_FORM_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_SITE_CUSTOM_DOMAIN_ENABLED=false
PUBLIC_SITE_INDEXING_ENABLED=false
PUBLIC_SITE_VERIFICATION_ENABLED=false

# IndexNow remains disabled until the canonical domain and indexing gates pass.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=soypms-indexnow-key

# Public demo request API. Keep disabled until legal and mail/DNS gates pass.
DEMO_REQUESTS_ENABLED=false
DEMO_CONSENT_POLICY_VERSION=draft-2026-07-28
DEMO_REQUEST_RATE_LIMIT_SECRET=replace-with-a-long-random-value
DEMO_REQUEST_RATE_LIMIT_REDIS_URL=
RESEND_API_KEY=
DEMO_NOTIFICATION_TO=
DEMO_FROM_EMAIL=

SUPABASE_PROJECT_REF=dgyfhuzwmlclyhsdplrs
SUPABASE_URL=https://dgyfhuzwmlclyhsdplrs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SUPABASE_URL=https://dgyfhuzwmlclyhsdplrs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# No local Postgres. These URLs point to the remote Supabase shared pooler.
# Keep secrets in ignored .env/.env.local files only; URL-encode special password characters.
DATABASE_URL="postgresql://prisma.dgyfhuzwmlclyhsdplrs:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://prisma.dgyfhuzwmlclyhsdplrs:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
SHADOW_DATABASE_URL=

JWT_ACCESS_SECRET=change-me-in-development
JWT_REFRESH_SECRET=change-me-in-development

# Comma-separated emails allowed to access the internal SaaS backoffice.
PLATFORM_ADMIN_EMAILS=owner@example.com
