{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", "package.json", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "env": [
        "API_PROXY_URL",
        "NEXT_PUBLIC_SITE_URL",
        "PUBLIC_SITE_CUSTOM_DOMAIN_ENABLED",
        "PUBLIC_SITE_INDEXING_ENABLED"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["db:generate", "^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "outputs": []
    }
  }
}
